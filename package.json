{
  "name": "swarmux",
  "version": "1.2.0",
  "description": "A real Windows terminal for running a swarm of coding agents: tabs, split panes, every shell and WSL distribution, session restore and alerts when a pane finishes.",
  "main": "src/main.js",
  "license": "MIT",
  "author": "QUANTUM",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Swarmux",
  "repository": "https://github.com/chsxthwik/SWARMUX",
  "build": {
    "appId": "com.quantum.swarmux",
    "productName": "Swarmux",
    "copyright": "\u00a9 2026 QUANTUM",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "build/icon.ico",
      "package.json",
      "node_modules/**",
      "!node_modules/**/*.{md,map,ts,pdb}",
      "!node_modules/**/{test,tests,docs,example,examples}/**",
      "!node_modules/node-pty/prebuilds/{darwin-*,win32-arm64}/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Swarmux-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Swarmux",
      "uninstallDisplayName": "Swarmux",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}